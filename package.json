{
  "name": "beide",
  "version": "0.2.0",
  "description": "beide — desktop IDE with AI agent (made in Belarus)",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "beide",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --win --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-ts.mjs electron/services/verification.test.ts",
    "supabase:setup": "node scripts/supabase-setup.mjs",
    "supabase:verify": "node scripts/supabase-verify.mjs",
    "supabase:secrets": "node scripts/supabase-secrets.mjs",
    "postinstall": "node scripts/patch-pi-deps.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@monaco-editor/react": "^4.7.0",
    "@pierre/diffs": "^1.2.12",
    "@streamdown/code": "^1.1.1",
    "@supabase/supabase-js": "^2.110.7",
    "@tabler/icons-react": "^3.45.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "i18next": "^24.2.2",
    "lucide-react": "^1.25.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.4.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "typebox": "1.1.38",
    "undici": "^7.28.0",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.9"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^7.0.32",
    "electron": "40.10.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  }
}
