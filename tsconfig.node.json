{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "target": "ESNext",
    "types": ["node"],
    "outDir": "./out",
    "baseUrl": ".",
    "paths": {
      "@main/*": ["electron/*"]
    }
  },
  "include": [
    "electron/**/*",
    "electron.vite.config.ts",
    "src/lib/types.ts",
    "src/lib/usage.ts"
  ],
  "exclude": [
    "electron/**/*.test.ts"
  ]
}
