# Supabase (Auth + DB) — NEVER commit real keys
# Project Settings → API in Supabase dashboard
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Service role — main process only, NOT committed.
# Either set SUPABASE_SERVICE_ROLE_KEY env var before launching,
# or drop it into %APPDATA%/beide/.beide-admin.env:
#   SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# AI provider API keys — main process only, NOT committed.
BEIDE_GOOGLE_API_KEY=your_google_api_key
BEIDE_NVIDIA_API_KEY=nvapi_your_nvidia_key

# Admin credentials for `npm run supabase:setup` ONLY.
# The app itself never loads these (they are not in its env allowlist).
BEIDE_ADMIN_EMAIL=owner@example.com
BEIDE_ADMIN_PASSWORD=choose_a_strong_password
