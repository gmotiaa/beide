# Supabase (Auth + DB) — the public hosted project is baked into the app
# (src/lib/supabase.ts). Set these ONLY to point at another stack (e.g. local
# `supabase start`). NEVER commit real keys.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=your_local_anon_key

# Service role — main process only, NOT committed.
# Either set SUPABASE_SERVICE_ROLE_KEY env var before launching,
# or drop it into %APPDATA%/beide/.beide-admin.env:
#   SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# There is NO provider-key variable anymore. Models are reachable exclusively
# through beide Cloud (the account-gated model proxy); the gateway key lives
# only server-side. BEIDE_ECHOGATE_API_KEY is not in the app's env allowlist.

# Admin credentials for `npm run supabase:setup` and
# `npm run supabase:secrets` ONLY.
# The app itself never loads these (they are not in its env allowlist).
BEIDE_ADMIN_EMAIL=owner@example.com
BEIDE_ADMIN_PASSWORD=choose_a_strong_password
