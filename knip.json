{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "electron/main.ts",
    "electron/preload.ts",
    "electron/services/verification.test.ts",
    "scripts/*.mjs",
    "electron.vite.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "electron/**/*.ts", "scripts/**/*.mjs"],
  "ignore": [".design-sync/**", "website/**", "src/lib/database.types.ts"],
  "_comment": "shadcn/tailwindcss/tw-animate-css look unused to knip but are pulled in via CSS @import in src/styles/global.css",
  "ignoreDependencies": ["monaco-editor", "tailwindcss", "tw-animate-css", "shadcn"]
}
